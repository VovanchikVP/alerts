# --- Telegram ---
ALERTS_BOT_TOKEN=123456:AA...                  # токен от @BotFather
ALERTS_ALLOWED_CHAT_IDS=-1001234567890,987654  # кому можно подписываться (узнать: /id)

# Прокси до api.telegram.org, если прямой выход из сети закрыт.
# Поддерживаются http://, socks4://, socks5:// (с логином: http://user:pass@host:3128)
# ALERTS_TELEGRAM_PROXY=

# --- приём алертов с сервера ---
ALERTS_API_HOST=0.0.0.0
ALERTS_API_PORT=8080
ALERTS_INGEST_API_KEY=смените-меня            # сервер шлёт его в заголовке X-API-Key

# --- отправка действий обратно на сервер ---
ALERTS_DEFAULT_CALLBACK_URL=https://ops.example.com/hooks/telegram-action
ALERTS_OUTBOUND_TOKEN=токен-сервера            # уйдёт в Authorization: Bearer
ALERTS_OUTBOUND_SECRET=секрет-подписи          # HMAC-SHA256 тела в заголовке X-Signature
ALERTS_OUTBOUND_TIMEOUT=10

# --- хранилище ---
ALERTS_DB_PATH=alerts.db
